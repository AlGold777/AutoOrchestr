{
  "required_methods": [
    "preflight",
    "openFreshConversation",
    "identifyConversation",
    "locatePromptInput",
    "insertPrompt",
    "verifyPromptDraft",
    "submitPrompt",
    "extractSubmittedUserMessage",
    "verifySubmittedPrompt",
    "locateAssistantMessage",
    "observeGenerationState",
    "observeTerminalState",
    "extractAssistantRawText",
    "detectRateLimit",
    "detectAuthenticationRequired",
    "detectCaptcha",
    "detectUiAmbiguity",
    "closeConversation"
  ],
  "preflight_capabilities": [
    "AUTH_OK",
    "NEW_CHAT_OK",
    "INPUT_FOUND",
    "SUBMIT_OK",
    "USER_MESSAGE_READABLE",
    "ASSISTANT_MESSAGE_READABLE",
    "GENERATION_STATE_OBSERVABLE",
    "TERMINAL_STATE_OBSERVABLE"
  ],
  "on_missing_critical": "ADAPTER_UNSAFE; autonomous production commit prohibited",
  "message_correlation": [
    "conversation_id",
    "tab_id",
    "call_id",
    "attempt_id",
    "CALL_TOKEN",
    "ATTEMPT_TOKEN"
  ],
  "never": "take last assistant message",
  "terminal_formula": "response_frame_complete AND provider_terminal_state_observed AND assistant_message_finalized",
  "source_message_identity": "adapter/transport-owned and stable enough to suppress repeated scrape/storage replay",
  "version": "2.2.2",
  "provider_matrix_ref": "browser/provider-matrix.json",
  "provider_matrix_rule": "all enabled MyOrchestrator providers must have a binding and pass provider-specific M1 extraction/correlation tests before production use",
  "structured_response_extraction": "correlated assistant node/code-block textContent/raw text only; rendered markdown/innerHTML reconstruction is forbidden as authoritative parser input"
}
