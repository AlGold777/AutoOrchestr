{
  "version": "2.2.2",
  "source_of_truth": "MyOrchestrator automation-gpt popup.html + manifest.json",
  "source_urls": [
    "https://github.com/AlGold777/MyOrchestrator/blob/automation-gpt/popup.html",
    "https://github.com/AlGold777/MyOrchestrator/blob/automation-gpt/manifest.json"
  ],
  "rule": "Every provider selectable in the current MyOrchestrator Web UI MUST have an Automation Layer adapter binding and MUST pass provider-specific M1 structured-response extraction/correlation smoke tests before that provider is enabled for production Automation runs.",
  "extraction_rule": "Extract the correlated assistant response or JSON code-block through DOM textContent/raw text only; innerHTML/rendered-markdown reconstruction is non-authoritative.",
  "m1_gate": "An individual provider may be QUARANTINED/disabled if its profile fails; M1 is green for production only for the explicitly enabled provider set, and every enabled provider must have both fixture and live smoke PASS evidence.",
  "providers": [
    {
      "provider": "chatgpt",
      "model_key": "chatgpt",
      "display_name": "ChatGPT",
      "content_script": "content-scripts/content-chatgpt.js",
      "hosts": [
        "*://chat.openai.com/*",
        "*://chatgpt.com/*"
      ]
    },
    {
      "provider": "claude",
      "model_key": "claude",
