{
  "type": "object",
  "required": [
    "code",
    "object_id",
    "version",
    "schema_version",
    "status",
    "blocking",
    "authority_class",
    "created_stage",
    "created_by_run",
    "payload",
    "provenance",
    "stale",
    "content_hash"
  ],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "AD",
        "AEV",
        "ASM",
        "BSL",
        "CAP",
        "CHG",
        "CMP",
        "CON",
        "DPL",
        "EVD",
        "FCT",
        "FND",
        "HRES",
        "HTSK",
        "IDEA",
        "PCON",
        "PD",
        "PRP",
        "QANS",
        "QST",
        "REQ",
        "RSK",
        "UNK"
      ]
    },
    "object_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*-[0-9A-Za-z._-]+$",
      "description": "Canonical stable ID allocated by orchestrator; never generated/reused by an LLM."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic version of the same object_id; orchestrator increments on committed revision."
    },
    "schema_version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "blocking": {
      "type": "boolean"
    },
    "authority_class": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "A0",
            "A1",
            "A2",
            "A3",
            "A4"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "created_stage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30
    },
    "created_by_run": {
      "type": "string",
      "description": "Trusted run_id injected by orchestrator."
    },
    "payload": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "required": [
        "input_refs",
        "stage_run_id",
        "authority_refs",
        "evidence_refs"
      ],
      "properties": {
        "input_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "object_id",
              "version"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "object_id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*-[0-9A-Za-z._-]+$"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "stage_run_id": {
          "type": "string"
        },
        "authority_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "object_id",
              "version"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "object_id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*-[0-9A-Za-z._-]+$"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "object_id",
              "version"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "object_id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*-[0-9A-Za-z._-]+$"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "code",
            "object_id",
            "version"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "object_id": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*-[0-9A-Za-z._-]+$"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "stale": {
      "type": "boolean"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of RFC8785/JCS canonical JSON of payload only; computed by orchestrator. It is never supplied by a model."
    }
  },
  "additionalProperties": false
}
