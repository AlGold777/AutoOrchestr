{
  "$id": "AL-STRUCT-1",
  "title": "Automation Layer v2.2 model semantic response",
  "type": "object",
  "required": [
    "passport",
    "outputs",
    "annotations",
    "trace",
    "input_fate",
    "changes",
    "completion"
  ],
  "properties": {
    "passport": {
      "type": "object",
      "required": [
        "contract",
        "stage",
        "input_snapshot_id",
        "input_snapshot_hash",
        "input_refs"
      ],
      "properties": {
        "contract": {
          "const": "AL-STRUCT-1"
        },
        "stage": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "input_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "input_snapshot_hash": {
          "type": "string",
          "pattern": "^(sha256:)?[a-f0-9]{64}$"
        },
        "input_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "object_id",
              "version"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "object_id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*-[0-9A-Za-z._-]+$"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "version",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OUT-[A-Za-z0-9._-]+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "ANSWER",
              "QUESTION",
              "REJECT"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "content": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "FACT",
              "ASSUMPTION",
              "CONSTRAINT",
              "DECISION",
              "RISK",
              "EVIDENCE",
              "FINDING",
              "CONFLICT",
              "OPEN",
              "DEFERRED",
              "CHANGE",
              "BASELINE",
              "VERIFIED",
              "REJECTED",
              "SUPERSEDED"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "output_id",
          "source_ids"
        ],
        "properties": {
          "output_id": {
            "type": "string",
            "pattern": "^OUT-[A-Za-z0-9._-]+$"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "input_fate": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "input_id",
          "disposition",
          "output_ids"
        ],
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "CONSUMED",
              "PRESERVED",
              "TRANSFORMED",
              "REJECTED",
              "SUPERSEDED",
              "NOT_USED"
            ]
          },
          "output_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^OUT-[A-Za-z0-9._-]+$"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "op",
          "object_type",
          "source_output_id"
        ],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "CREATE",
              "UPDATE",
              "SUPERSEDE",
              "MERGE"
            ]
          },
          "object_type": {
            "type": "string",
            "enum": [
              "AD",
              "AEV",
              "ASM",
              "BSL",
              "CAP",
              "CHG",
              "CMP",
              "CON",
              "DPL",
              "EVD",
              "FCT",
              "FND",
              "HRES",
              "HTSK",
              "IDEA",
              "PCON",
              "PD",
              "PRP",
              "QANS",
              "QST",
              "REQ",
              "RSK",
              "UNK"
            ]
          },
          "temp_id": {
            "type": "string",
            "pattern": "^tmp-[a-z0-9][a-z0-9._-]*$"
          },
          "target_ref": {
            "type": "object",
            "required": [
              "code",
              "object_id",
              "version"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "object_id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*-[0-9A-Za-z._-]+$"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "source_output_id": {
            "type": "string",
            "pattern": "^OUT-[A-Za-z0-9._-]+$"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "object_id",
                "version"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "object_id": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*-[0-9A-Za-z._-]+$"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            "uniqueItems": true
          },
          "payload": {
            "type": "object"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "op": {
                  "const": "CREATE"
                }
              }
            },
            "then": {
              "required": [
                "temp_id"
              ],
              "not": {
                "required": [
                  "target_ref"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "enum": [
                    "UPDATE",
                    "SUPERSEDE"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "target_ref"
              ],
              "not": {
                "required": [
                  "temp_id"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "const": "MERGE"
                }
              }
            },
            "then": {
              "required": [
                "temp_id",
                "source_refs"
              ],
              "properties": {
                "source_refs": {
                  "minItems": 2
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "completion": {
      "type": "object",
      "required": [
        "status",
        "output_ids",
        "output_count",
        "empty_by_design",
        "anomalies"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "FAILED"
          ]
        },
        "output_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^OUT-[A-Za-z0-9._-]+$"
          },
          "uniqueItems": true
        },
        "output_count": {
          "type": "integer",
          "minimum": 0
        },
        "empty_by_design": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "enum": [
            "NO_MATERIAL_DELTA"
          ]
        },
        "anomalies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "empty_by_design": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "output_count": {
                "const": 0
              },
              "output_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-semantic-rules": [
    "completion.output_count MUST equal len(outputs)",
    "completion.output_ids MUST equal the set of outputs[].id",
    "trace.output_id MUST reference outputs[].id",
    "trace.source_ids MUST reference ids available in passport.input_refs or contract-allowed response-local sources",
    "input_fate.input_id MUST refer to an input passed in passport.input_refs",
    "changes.source_output_id MUST refer to outputs[].id",
    "input_snapshot_hash MUST byte-for-byte equal ACTIVE.input_snapshot_hash",
    "reserved runtime fields are prohibited anywhere in model-controlled payload",
    "CONSUMED means processed only; it does not imply closed/verified/resolved"
  ]
}
