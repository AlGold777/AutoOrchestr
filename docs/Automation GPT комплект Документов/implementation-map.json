    "semantic-validator.js",
    "mutation-normalizer.js",
    "state-committer.js",
    "gate-engine.js",
    "baseline-service.js",
    "interaction-engine.js",
    "recovery.js",
    "export.js"
  ],
  "milestones": [
    "M0 bundle loader/lint + precompiled validators",
    "M1 synthetic zero-commit transport probe across enabled provider matrix",
    "M2 IndexedDB state core + MutationNormalizer + StateCommitter + replay",
    "M3 stages 1-13 + questionnaire + G1/PFB",
    "M4 stages 14-17 + evidence + G2/AIP",
    "M5 stages 18-30 + G4/CAB",
    "M6 hardening/failover/export/crash matrix"
  ],
  "m1_probe_ref": "tests/m1-transport-stage.json",
  "integration_boundary_ref": "integration/existing-runtime-boundary.json",
