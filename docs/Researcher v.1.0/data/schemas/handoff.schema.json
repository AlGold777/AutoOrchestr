{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "researcher/handoff.schema.json",
  "title": "Передача результата и квитанция",
  "type": "object",
  "properties": {
    "handoff": {
      "type": "object",
      "description": "Блок передачи",
      "properties": {
        "from_role": {
          "type": "string",
          "description": "Кто передаёт",
          "minLength": 1
        },
        "to_role": {
          "type": "string",
          "description": "Кому",
          "minLength": 1
        },
        "work_done": {
          "type": "string",
          "description": "Что сделано",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Доказательства: номера вердиктов и источников",
          "minItems": 1
        },
        "limits": {
          "type": "string",
          "description": "Пределы применимости, что не проверялось",
          "minLength": 1
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Что осталось неизвестным",
          "minItems": 1
        },
        "acceptance_criteria": {
          "type": "string",
          "description": "По чему судить о пригодности",
          "minLength": 1
        }
      },
      "required": [
        "from_role",
        "to_role",
        "work_done",
        "evidence",
        "limits",
        "open_questions",
        "acceptance_criteria"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "description": "Квитанция",
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "принято",
            "возвращено"
          ],
          "description": "Решение получателя"
        },
        "missing": {
          "type": "string",
          "description": "Чего не хватает, если возвращено"
        }
      },
      "required": [
        "decision"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "handoff"
  ],
  "additionalProperties": false
}
