diff --git a/tests/automation-journal-observations.test.js b/tests/automation-journal-observations.test.js
new file mode 100644
index 0000000..558aff2
--- /dev/null
+++ b/tests/automation-journal-observations.test.js
@@ -0,0 +1,39 @@
+/** @jest-environment node */
+const Delivery = require('../shared/message-delivery.js');
+
+const tokenOf = (prompt) => /\[\[AO-[a-z0-9]{6}\]\]/.exec(prompt)[0];
+
+describe('journal observations', () => {
+  beforeEach(() => Delivery.reset());
+
+  test('the prompt and the final answer text are kept (capped)', () => {
+    const prompts = Delivery.prepare({ prompt: 'Вопрос '.repeat(500), models: ['GPT'] });
+    Delivery.receive({ llmName: 'GPT', answer: `${'Ответ '.repeat(500)}\n${tokenOf(prompts.GPT)}`, status: 'SUCCESS' }, { final: true });
+    const events = Delivery.journal();
+    expect(events.find((e) => e.kind === 'sent').prompt.length).toBeLessThanOrEqual(2000);
+    expect(events.find((e) => e.kind === 'verified').answer.length).toBeLessThanOrEqual(1500);
+  });
+
+  test('page navigation, the completion decision and tab focus moves are recorded per model', () => {
+    Delivery.prepare({ prompt: 'Q', models: ['Le Chat'] });
+    Delivery.observeRuntime({ type: 'SPA_NAVIGATION', llmName: 'Le Chat', oldUrl: 'https://chat.mistral.ai/work', newUrl: 'https://chat.mistral.ai/work/abc', reason: 'url_change' });
+    Delivery.observeRuntime({ type: 'LLM_COMPLETION_TERMINAL', llmName: 'Le Chat', meta: { terminalResult: { status: 'CONTEXT_LOST', reason: 'context_invalidated' } } });
+    for (let i = 0; i < 45; i += 1) Delivery.observeRuntime({ type: 'AUTOMATION_TAB_FOCUS', llmName: 'Le Chat', tabId: 7, source: 'human_visit_activate' });
+    const events = Delivery.journal();
+    expect(events.find((e) => e.kind === 'page_navigation')).toMatchObject({ from: '/work', to: '/work/abc' });
+    expect(events.find((e) => e.kind === 'completion_decision')).toMatchObject({ decision: 'CONTEXT_LOST', reason: 'context_invalidated' });
+    expect(events.filter((e) => e.kind === 'tab_focus')).toHaveLength(40);
+  });
+
+  test('the growing text is sampled at most every 10 seconds', () => {
+    Delivery.prepare({ prompt: 'Q', models: ['GPT'] });
+    Delivery.receive({ llmName: 'GPT', answer: 'a' }, { final: false });
+    Delivery.receive({ llmName: 'GPT', answer: 'ab' }, { final: false });
+    expect(Delivery.journal().filter((e) => e.kind === 'text_snapshot')).toHaveLength(1);
+  });
+
+  test('events of models without a pending request are ignored', () => {
+    Delivery.observeRuntime({ type: 'SPA_NAVIGATION', llmName: 'Grok', oldUrl: 'https://grok.com/', newUrl: 'https://grok.com/c/1' });
+    expect(Delivery.journal()).toEqual([]);
+  });
+});
