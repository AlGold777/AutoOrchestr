{
  "interaction": {
    "after_G1_only_on_normal_flow": true,
    "task_schema": "HTSK",
    "result_schema": "HRES",
    "executor": "Human Tester",
    "system_actions": [
      "generate test plan",
      "present task",
      "validate result",
      "materialize EVD",
      "route result"
    ]
  },
  "boundary": {
    "definition": "HUMAN_TEST means real-world execution or user/device/product acceptance observation. Only Human Tester may execute it.",
    "model_allowed": [
      "scenario analysis",
      "static analysis",
      "source research",
      "sandbox experiments",
      "test-plan generation",
      "result analysis"
    ],
    "before_G1": "No HUMAN_TEST. Stage 9 is scenario/model analysis only.",
    "after_G1": "Stage 25 may create HTSK. Pipeline waits for HRES, then deterministically materializes EVD(method_kind=HUMAN_TEST)."
  },
  "objects": {
    "HTSK": {
      "type": "object",
      "required": [
        "question_ref",
        "acceptance_refs",
        "steps",
        "expected",
        "safety_constraints"
      ],
      "properties": {
        "question_ref": {
          "type": "object",
          "required": [
            "code",
            "object_id",
            "version"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "object_id": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*-[0-9A-Za-z._-]+$"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "acceptance_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "object_id",
              "version"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "object_id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*-[0-9A-Za-z._-]+$"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "expected": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "safety_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "HRES": {
      "type": "object",
      "required": [
        "task_ref",
        "outcome",
        "observations",
        "completed_at"
      ],
      "properties": {
        "task_ref": {
          "type": "object",
          "required": [
            "code",
            "object_id",
            "version"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "object_id": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*-[0-9A-Za-z._-]+$"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "outcome": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "EVD": {
      "type": "object",
      "required": [
        "answers_ref",
        "method_kind",
        "result",
        "verifies",
        "falsifies",
        "artifact_refs",
        "reproducible",
        "executor"
      ],
      "properties": {
        "answers_ref": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "code",
                "object_id",
                "version"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "object_id": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*-[0-9A-Za-z._-]+$"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "method_kind": {
          "type": "string",
          "enum": [
            "MODEL_ANALYSIS",
            "EXTERNAL_SOURCE",
            "STATIC_ANALYSIS",
            "SANDBOX_EXPERIMENT",
            "HUMAN_TEST"
          ]
        },
        "result": {
          "type": "string"
        },
        "verifies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "object_id",
              "version"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "object_id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*-[0-9A-Za-z._-]+$"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "falsifies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "object_id",
              "version"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "object_id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*-[0-9A-Za-z._-]+$"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reproducible": {
          "type": "boolean"
        },
        "executor": {
          "type": "object",
          "required": [
            "actor_type",
            "actor_id"
          ],
          "properties": {
            "actor_type": {
              "type": "string",
              "enum": [
                "MODEL",
                "TOOL",
                "HUMAN"
              ]
            },
            "actor_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
