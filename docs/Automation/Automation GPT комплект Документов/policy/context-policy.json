{
  "version": "2.2.4",
  "maxPromptChars": 60000,
  "maxOutputContentChars": 8000,
  "representations": [
    "RAW",
    "CANONICAL",
    "CONTEXT"
  ],
  "assembly_order": [
    "RULES",
    "STATE",
    "ACTIVE",
    "DELTA",
    "TASK"
  ],
  "registry_projection": "REFERENCE_FIRST",
  "safe_truncation": {
    "scope": "CONTEXT_ONLY",
    "marker": "[OBJ:TRUNC]",
    "boundary": "deterministic safe boundary"
  },
  "protected_from_eviction": [
    "current-stage accountable refs",
    "required contract fields",
    "input_snapshot_id",
    "input_snapshot_hash",
    "active policy/authority material required by stage"
  ],
  "overflow": "PROMPT_TOO_LARGE",
  "silent_eviction": false,
  "historical_chat_transcript_as_context": false,
  "hash_format": "lowercase bare 64-hex SHA-256"
}
