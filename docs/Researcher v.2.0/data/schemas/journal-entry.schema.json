{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "researcher/journal-entry.schema.json",
  "title": "Запись цикла",
  "type": "object",
  "properties": {
    "n": {
      "type": "string",
      "description": "Номер записи: <цикл>.<а|б>.<порядковый>"
    },
    "cycle": {
      "type": "integer",
      "description": "Номер цикла",
      "minimum": 0
    },
    "type": {
      "type": "string",
      "enum": [
        "plan",
        "fact",
        "hypothesis",
        "claim",
        "exec",
        "verdict",
        "alternative",
        "conflict",
        "gap",
        "pit",
        "trigger",
        "rebuild",
        "owner_decision",
        "core_change",
        "branch_closed",
        "incomplete_step",
        "closed_set_access",
        "correction",
        "calibration",
        "trial_setup"
      ],
      "description": "Вид события"
    },
    "ref": {
      "type": "string",
      "description": "Номер объекта: G, H, V, F, K, P, Y, X"
    },
    "step": {
      "type": "string",
      "description": "Шаг схемы и участник, из чьего ответа взято",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "description": "Содержание без толкования",
      "minLength": 1
    },
    "corrects": {
      "type": "integer",
      "description": "Номер записи, которую исправляет",
      "minimum": 1
    },
    "config_id": {
      "type": "string",
      "description": "Конфигурация",
      "minLength": 1
    }
  },
  "required": [
    "n",
    "cycle",
    "type",
    "step",
    "text",
    "config_id"
  ],
  "additionalProperties": false
}
