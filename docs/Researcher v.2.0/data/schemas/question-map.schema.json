{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "researcher/question-map.schema.json",
  "title": "Карта вопроса",
  "type": "object",
  "properties": {
    "cycle": {
      "type": "integer",
      "description": "Номер последнего учтённого цикла",
      "minimum": 0
    },
    "config_id": {
      "type": "string",
      "description": "Действующая конфигурация",
      "minLength": 1
    },
    "core_version": {
      "type": "integer",
      "description": "Версия ядра",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "идёт",
        "застой",
        "на испытании перестройки",
        "заморожена",
        "остановлена"
      ],
      "description": "Состояние задачи"
    },
    "progress": {
      "type": "object",
      "description": "Валюты прогресса",
      "properties": {
        "constraints": {
          "type": "integer",
          "description": "В1: число действующих ям-предикатов",
          "minimum": 0
        },
        "expressibility": {
          "type": "integer",
          "description": "В2: подтверждённые единицы выразимости",
          "minimum": 0
        },
        "verifiability": {
          "type": "integer",
          "description": "В3: откалиброванные способы проверки",
          "minimum": 0
        },
        "last_gain_cycle": {
          "type": "integer",
          "description": "Цикл последнего прироста",
          "minimum": 0
        }
      },
      "required": [
        "constraints",
        "expressibility",
        "verifiability",
        "last_gain_cycle"
      ],
      "additionalProperties": false
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Факты: номер, утверждение, класс"
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Гипотезы: номер, утверждение, состояние, цена проверки"
    },
    "active_hypothesis": {
      "type": "string",
      "description": "Номер активной гипотезы"
    },
    "pits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Ямы: номер, ключ, правило обхода"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Пробелы: номер, чего не хватает, состояние"
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Противоречия: номер, точка спора, состояние"
    },
    "open_deadlines": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Отложенные предсказания: номер, тест, срок"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Кандидаты в выразимость: понятие, срок"
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Сработавшие триггеры и диагнозы"
    },
    "owner_queue": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Очередь решений владельца"
    },
    "incomplete_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Шаги, пропущенные из-за выпавшей модели"
    },
    "next_step": {
      "type": "string",
      "description": "Что делать в следующем цикле",
      "minLength": 1
    }
  },
  "required": [
    "cycle",
    "config_id",
    "core_version",
    "state",
    "progress",
    "facts",
    "hypotheses",
    "pits",
    "gaps",
    "conflicts",
    "open_deadlines",
    "next_step"
  ],
  "additionalProperties": false,
  "description": "Карта вопроса: состояние задачи. Каждая строка несёт номер записи цикла, из которой взята; строка без номера — «не проверено». Расход и остаток бюджета — в разделе «ХОД» пакета, а не в карте"
}
