{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "researcher/core-lock.schema.json",
  "title": "Замок ядра",
  "type": "object",
  "properties": {
    "core_version": {
      "type": "integer",
      "description": "Версия ядра",
      "minimum": 1
    },
    "ratified_at": {
      "type": "string",
      "description": "Дата ратификации UTC",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "description": "Владелец",
      "minLength": 1
    },
    "observer": {
      "type": "string",
      "description": "Внешний наблюдатель; пусто — прогон не претендует на статус выше S1"
    },
    "hashes": {
      "type": "object",
      "description": "Хеши документов ядра",
      "properties": {
        "task_card": {
          "type": "string",
          "description": "SHA-256 карточки задачи",
          "pattern": "^[0-9a-f]{64}$"
        },
        "thresholds": {
          "type": "string",
          "description": "SHA-256 файла порогов",
          "pattern": "^[0-9a-f]{64}$"
        },
        "config_c0": {
          "type": "string",
          "description": "SHA-256 конфигурации C0",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prompts": {
          "type": "string",
          "description": "SHA-256 папки prompts",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schemas": {
          "type": "string",
          "description": "SHA-256 папки basic/schemas",
          "pattern": "^[0-9a-f]{64}$"
        },
        "methodology": {
          "type": "string",
          "description": "SHA-256 папки methodology",
          "pattern": "^[0-9a-f]{64}$"
        },
        "owner_sealed_test": {
          "type": "string",
          "description": "SHA-256 запечатанных ожиданий владельца",
          "pattern": "^[0-9a-f]{64}$"
        },
        "extract": {
          "type": "string",
          "description": "SHA-256 выжимки ядра core/extract.txt: она входит в каждый пакет без изменений"
        }
      },
      "required": [
        "task_card",
        "thresholds",
        "config_c0",
        "prompts",
        "schemas",
        "methodology",
        "extract"
      ],
      "additionalProperties": false
    },
    "closed_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Имя набора",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "зачётный",
              "финальный",
              "корпус порч",
              "посевы"
            ],
            "description": "Вид набора"
          },
          "sha256": {
            "type": "string",
            "description": "SHA-256 набора",
            "pattern": "^[0-9a-f]{64}$"
          },
          "holder": {
            "type": "string",
            "description": "У кого хранится",
            "minLength": 1
          },
          "access_limit": {
            "type": "integer",
            "description": "Предел обращений",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "kind",
          "sha256",
          "holder",
          "access_limit"
        ],
        "additionalProperties": false
      },
      "description": "Закрытые наборы"
    }
  },
  "required": [
    "core_version",
    "ratified_at",
    "owner",
    "hashes",
    "closed_sets"
  ],
  "additionalProperties": false,
  "description": "Замок ядра. После подписи не меняется: обращения к закрытым наборам и числа калибровки записываются событиями журнала"
}
