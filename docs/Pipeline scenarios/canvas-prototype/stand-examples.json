{
  "basic": {
    "task": "Подготовить план запуска нового тарифа для малого бизнеса",
    "steps": [
      {
        "id": "s1",
        "block": "source",
        "kind": "text",
        "title": "Описание тарифа",
        "content": "Тариф «Старт» для малого бизнеса: 5 пользователей, 990 ₽ в месяц, запуск через 6 недель.",
        "artifacts": [
          "Бриф"
        ],
        "why": "Даёт всем моделям одинаковые исходные данные о тарифе."
      },
      {
        "id": "s2",
        "block": "round",
        "title": "Первые планы",
        "order": "parallel",
        "task": "Предложи план запуска тарифа по брифу.",
        "inputs": [
          "s1.Бриф"
        ],
        "artifacts": [
          "Черновики"
        ],
        "models": [
          {
            "name": "Claude",
            "role": "автор",
            "task": "Сделай упор на сроки и этапы."
          },
          {
            "name": "GPT",
            "role": "критик",
            "task": "Ищи риски и слабые места."
          },
          {
            "name": "Gemini",
            "role": "аналитик",
            "task": "Оцени рынок и цены."
          }
        ],
        "why": "Три независимых взгляда на одну задачу."
      },
      {
        "id": "s3",
        "block": "synthesis",
        "title": "Сводный план",
        "model": "Claude",
        "role": "свести",
        "task": "Сведи черновики в один план.",
        "inputs": [
          "s2.Черновики"
        ],
        "artifacts": [
          "План"
        ],
        "why": "Нужен один план вместо трёх."
      },
      {
        "id": "s4",
        "block": "gate",
        "title": "Проверка плана",
        "criteria": "Есть сроки, бюджет и ответственные; нет противоречий.",
        "inputs": [
          "s3.План"
        ],
        "artifacts": [
          "Вердикт"
        ],
        "why": "Не отдавать план без сроков и бюджета."
      },
      {
        "id": "s5",
        "block": "round",
        "title": "Доработка",
        "repeats": "s2",
        "because": "проверка s4 не пройдена",
        "order": "sequential",
        "task": "Исправь план по замечаниям проверки.",
        "inputs": [
          "s3.План",
          "s4.Вердикт"
        ],
        "artifacts": [
          "Правки"
        ],
        "models": [
          {
            "name": "Claude",
            "role": "автор"
          },
          {
            "name": "GPT",
            "role": "критик"
          },
          {
            "name": "Gemini",
            "role": "аналитик"
          }
        ],
        "why": "Закрыть замечания проверки."
      },
      {
        "id": "s6",
        "block": "synthesis",
        "title": "Итоговый план",
        "repeats": "s3",
        "because": "после доработки",
        "model": "GPT",
        "role": "судья",
        "task": "Собери итоговый план с учётом правок.",
        "inputs": [
          "s5.Правки",
          "s3.План"
        ],
        "artifacts": [
          "Итог"
        ],
        "why": "Окончательная версия плана."
      },
      {
        "id": "s7",
        "block": "gate",
        "title": "Повторная проверка плана",
        "repeats": "s4",
        "because": "после доработки",
        "criteria": "Есть сроки, бюджет и ответственные; нет противоречий.",
        "inputs": [
          "s6.Итог"
        ],
        "why": "Закрыть петлю проверкой."
      },
      {
        "id": "s8",
        "block": "file",
        "title": "Сохранить план",
        "file": "plan.md",
        "mode": "overwrite",
        "inputs": [
          "s6.Итог"
        ],
        "why": "Результат нужен файлом."
      }
    ]
  },
  "foreach": {
    "task": "Оценить каждую идею из списка и собрать рейтинг",
    "steps": [
      {
        "id": "s1",
        "block": "source",
        "kind": "document",
        "title": "Список идей",
        "attachment": "идеи.md",
        "artifacts": [
          "Идеи"
        ],
        "why": "Исходный материал — документ с идеями."
      },
      {
        "id": "s2",
        "block": "list",
        "title": "Разбить на пункты",
        "from": "s1.Идеи",
        "rule": "одна идея — один пункт",
        "artifacts": [
          "Пункты"
        ],
        "why": "Каждую идею разбираем отдельно."
      },
      {
        "id": "s3",
        "block": "foreach",
        "title": "Разбор каждой идеи",
        "over": "s2.Пункты",
        "artifacts": [
          "Разборы"
        ],
        "why": "Одинаковый разбор для всех пунктов.",
        "body": [
          {
            "id": "s3a",
            "block": "round",
            "title": "Разбор идеи",
            "models": [
              {
                "name": "Claude",
                "role": "аналитик"
              },
              {
                "name": "GPT",
                "role": "критик"
              }
            ],
            "task": "Разбери идею: плюсы, минусы, риски.",
            "inputs": [
              "s3"
            ],
            "artifacts": [
              "Мнения"
            ],
            "why": "Два взгляда на идею."
          },
          {
            "id": "s3b",
            "block": "synthesis",
            "title": "Вывод по идее",
            "model": "Gemini",
            "role": "сгруппировать",
            "inputs": [
              "s3a.Мнения"
            ],
            "artifacts": [
              "Вывод"
            ],
            "why": "Один вывод на идею."
          }
        ]
      },
      {
        "id": "s4",
        "block": "assemble",
        "title": "Собрать отчёт",
        "inputs": [
          "s3.Разборы"
        ],
        "template": "# Идеи\n{для каждой: название, вывод}",
        "artifacts": [
          "Отчёт"
        ],
        "why": "Все разборы в одном документе."
      },
      {
        "id": "s5",
        "block": "score",
        "title": "Рейтинг",
        "inputs": [
          "s4.Отчёт"
        ],
        "criteria": [
          "польза",
          "стоимость",
          "риск"
        ],
        "weights": {
          "польза": 0.5,
          "стоимость": 0.3,
          "риск": 0.2
        },
        "artifacts": [
          "Рейтинг"
        ],
        "why": "Порядок, в котором браться за идеи."
      }
    ]
  },
  "defaults": {
