{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalysisResult",
  "type": "object",
  "required": ["schemaVersion", "mode", "status", "coordinateSystem", "frameSpec", "errors"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "mode": {"enum": ["mock", "pose"]},
    "status": {"enum": ["ready", "insufficient_data", "error"]},
    "coordinateSystem": {"const": "normalized-top-left-y-down"},
    "analysisVersion": {"type": "string"},
    "modelVersion": {"type": "string"},
    "frameSpec": {"type": "object", "required": ["athlete", "reference"]},
    "qualityWarnings": {"type": "array"},
    "unassessablePhases": {"type": "array"},
    "error": {"type": "object", "required": ["code", "message", "retryable"]},
    "errors": {"type": "array", "items": {
      "type": "object",
      "required": ["id", "code", "shotIndex", "referenceShotIndex", "phase", "athleteMs", "referenceMs", "evidence"],
      "properties": {
        "phase": {"enum": ["preparation", "contact", "follow", "recovery"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["svg-preset", "keypoints"]}}}
      }
    }}
  }
}
