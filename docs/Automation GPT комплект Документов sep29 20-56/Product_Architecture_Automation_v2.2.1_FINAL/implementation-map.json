    "semantic-validator.js",
    "mutation-normalizer.js",
    "state-committer.js",
    "gate-engine.js",
    "baseline-service.js",
    "interaction-engine.js",
    "recovery.js",
    "export.js"
  ],
  "milestones": [
    "M0 bundle loader/lint",
    "M1 one real Web AL-STRUCT-1 call",
    "M2 atomic canonical commit",
    "M3 stages 1-13 + G1/PFB",
    "M4 stages 14-17 + G2/AIP",
    "M5 stages 18-30 + G4/CAB",
    "M6 hardening"
  ]
