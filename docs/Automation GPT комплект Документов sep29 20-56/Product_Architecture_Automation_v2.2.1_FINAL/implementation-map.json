{
  "version": "2.2.0",
  "target": "AlGold777/MyOrchestrator",
  "existing_runtime_owns": [
    "provider tabs",
    "provider DOM",
    "prompt insertion/submission",
    "terminal state detection",
    "stale-answer protection",
    "assistant extraction",
    "provider recovery",
    "compressed jobState"
  ],
