{
  "IDEA": {
    "type": "object",
    "required": [
      "raw_text",
      "submitted_at",
      "source_hash"
    ],
    "properties": {
      "raw_text": {
        "type": "string",
        "minLength": 1
      },
      "submitted_at": {
        "type": "string",
        "format": "date-time"
      },
      "source_hash": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "additionalProperties": false,
    "description": "Исходная идея пользователя. Единственный свободный текст на входе."
  },
  "DPL": {
    "type": "object",
    "required": [
      "profile_id",
      "authority_rules",
      "post_g1_autonomy",
      "scope_change_policy",
      "selected_from"
    ],
    "properties": {
      "profile_id": {
        "type": "string"
      },
      "authority_rules": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "authority_class",
            "decision_kinds",
            "mode",
            "max_risk"
          ],
          "properties": {
            "authority_class": {
              "type": "string",
              "enum": [
                "A0",
                "A1",
                "A2",
                "A3",
                "A4"
              ]
            },
            "decision_kinds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "mode": {
              "type": "string",
              "enum": [
                "AUTO_POLICY",
                "REQUIRE_EVIDENCE",
                "REQUIRE_OWNER_SELECTION",
                "PROHIBITED"
              ]
            },
            "max_risk": {
              "type": "string",
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH",
                "CRITICAL"
              ]
            },
            "predicate_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence_required": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "post_g1_autonomy": {
        "type": "object",
        "required": [
          "architecture_direction_rule",
          "risk_acceptance_rule",
          "technical_choice_rule"
        ],
        "properties": {
          "architecture_direction_rule": {
            "type": "string"
          },
          "risk_acceptance_rule": {
            "type": "string"
          },
          "technical_choice_rule": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "scope_change_policy": {
        "type": "string",
        "enum": [
          "STOP_AND_REOPEN_PRODUCT_BASELINE"
        ]
      },
      "selected_from": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "object_id",
            "version"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "object_id": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*-[0-9A-Za-z._-]+$"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false,
    "description": "Project-specific Decision Policy, активируемая только через ответы Owner."
  },
